# Copy to .env; docker compose reads it. Every key is optional.

# Posters, Czech overviews, ratings, cast and filmographies: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# More torrent sources through Jackett (docker compose --profile torrents up -d jackett flaresolverr)
JACKETT_URL=
JACKETT_API_KEY=

# Voice commands the built-in rules do not understand
ANTHROPIC_API_KEY=

# Films and series from your own disk (default ./media)
# MEDIA_DIR=/path/to/films
