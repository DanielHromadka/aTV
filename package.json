{
  "name": "atv",
  "version": "0.1.0",
  "private": true,
  "description": "aTV: a remote-controlled TV launcher for Samsung (Tizen), LG (webOS) and Android TV / Google TV (TCL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "hub": "node --watch hub/index.ts",
    "build": "vite build",
    "start": "node hub/index.ts",
    "typecheck": "tsc --noEmit && tsc -p hub/tsconfig.json",
    "test": "vitest run",
    "up": "sh scripts/docker-up.sh",
    "seed": "node scripts/jellyfin-seed.mjs",
    "expand:actors": "node scripts/expand-actors.ts",
    "import:art": "node scripts/import-art.ts",
    "import:musicians": "node scripts/import-musicians.ts",
    "import:actors": "node scripts/import-actors.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "build:tizen": "npm run build && node scripts/platform-build.mjs tizen",
    "build:webos": "npm run build && node scripts/platform-build.mjs webos",
    "build:android": "npm run build && node scripts/platform-build.mjs android",
    "deploy:tizen": "sh scripts/deploy-tizen.sh",
    "smoke:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-legacy": "^8.2.3",
    "acorn": "^8.19.0",
    "hls.js": "^1.7.4",
    "preact": "^11.1.0",
    "qrcode-generator": "^2.0.4",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.22.0",
    "xml2js": "^0.6.2"
  }
}
